# AgriSense Backend - Environment Configuration Template
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
ML_SERVICE_URL=http://localhost:8000
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agrisense?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here

# Open Government Data (data.gov.in) API Credentials
DATA_GOV_IN_API_KEY=your_data_gov_in_api_key_here
DATA_GOV_IN_RESOURCE_ID=35985678-0d79-46b4-9ed6-6f13308a1d24
DATA_GOV_IN_BASE_URL=https://api.data.gov.in/resource

# OpenWeatherMap API Credentials
OPENWEATHER_API_KEY=your_openweathermap_api_key_here
