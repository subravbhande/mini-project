{
  "model": {
    "name": "XGBoostRegressor",
    "version": "2.0.0",
    "target_type": "log_relative_return",
    "clip_range": [-0.5, 0.5],
    "hyperparameters": {
      "n_estimators": 150,
      "max_depth": 3,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "min_child_weight": 5,
      "random_state": 42,
      "n_jobs": -1
    }
  },
  "training": {
    "target_column": "Modal Price",
    "forecast_horizons": [1, 2, 3, 4, 5],
    "min_history_days": 120
  },
  "rain_risk": {
    "rain_risk_mm": 15.0,
    "heavy_rain_mm": 50.0,
    "heavy_wmo_codes": [65, 82, 95, 96, 99]
  },
  "harvest_seasons": {
    "tomato": {
      "comment": "Main Kharif harvest Oct-Jan; Summer crop Apr-Jun",
      "peak_months": [10, 11, 12, 1, 4, 5, 6]
    },
    "onion": {
      "comment": "Rabi harvest Feb-May; Kharif Oct-Dec",
      "peak_months": [2, 3, 4, 5, 10, 11, 12]
    }
  },
  "weather": {
    "weather_clean_csv": "data/processed/weather_history_clean.csv"
  },
  "paths": {
    "price_data": "data/processed/price_history_filtered.csv",
    "models_dir": "models/saved",
    "supported_series": "models/saved/supported_series.json",
    "residual_quantiles": "models/saved/residual_quantiles.json",
    "backtest_report": "models/saved/backtest_report.json"
  }
}
