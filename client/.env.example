# AgriSense Frontend (Client) Environment Variables Template
# On Vercel, set these in: Project Settings -> Environment Variables

# Backend API URL (Your Render Backend URL)
VITE_API_URL=https://agrisense-backend.onrender.com

# Client fallback Gemini API Key for AI Farmer Assistant
VITE_GEMINI_API_KEY=your_gemini_api_key_here
